# Board
CONFIG_BOARD_XIAOMI_STAR=y

# Fingerprint
CONFIG_FINGERPRINT_GOODIX_FOD=y

# Haptics
# CONFIG_INPUT_QCOM_HV_HAPTICS is not set
CONFIG_INPUT_AW8697_HAPTIC=y

# Schedutil
CONFIG_XIAOMI_CPUFREQ_EFF=y

# Time of flight
CONFIG_STMVL53L5=y

# Power Supply
CONFIG_BQ2597X=y
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_BQ_FG_1S=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_DEVICE_ACCESS=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_I2C=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_LOADER=y
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# WiFi
CONFIG_CNSS_QCA6490=y

# Wireless charging
CONFIG_MI_WIRELESS=y


#
# DIAGNOSTIC (temporary, remove once the boot failure is found).
# The stock settings are PANIC_ON_OOPS=y + PANIC_TIMEOUT=-1, i.e. any oops
# becomes a panic and the box reboots instantly - which is why the failure is
# invisible: a clean bootloop with nothing on screen and no USB.
#   - not panicking on an oops lets a driver blow up without killing the boot,
#     so the kernel may reach userspace and give us adb + a full dmesg.
#   - panic_timeout 0 makes a real panic HANG instead of rebooting, which by
#     itself tells us the kernel panicked rather than being rejected earlier.
#
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_TIMEOUT=0

# Qualcomm's own 5.10 IOMMU layer: lahaina's apps_smmu is a QTI MMU-500 that
# needs qsmmuv500_impl_init() and TBU power management, not the generic shim.
CONFIG_QCOM_IOMMU_UTIL=y
CONFIG_QCOM_IOMMU_DEBUG=y

# DIAGNOSTIC: lahaina ships no /reserved-memory ramoops node, so a panic or a
# hang leaves no trace anywhere - /sys/fs/pstore is always empty. Configure the
# driver from the command line instead of the DTB: AnyKernel3 only rewrites
# "boot", and this SoC takes its DTB from vendor_boot, so a DTS node never
# reaches the kernel. arm64_memblock_init() parses the same two parameters to
# carve the region out of the page allocator.
#
# The reader kernel must use the identical address or it cannot see the log.
CONFIG_CMDLINE="cgroup_disable=pressure ramoops.mem_address=0xd0000000 ramoops.mem_size=0x400000 ramoops.mem_type=2 ramoops.console_size=0x200000 ramoops.record_size=0x40000 ramoops.pmsg_size=0x40000 ramoops.ftrace_size=0"
CONFIG_CMDLINE_EXTEND=y
