# Board
CONFIG_BOARD_XIAOMI_STAR=y

# Fingerprint
CONFIG_FINGERPRINT_GOODIX_FOD=y

# Haptics
# CONFIG_INPUT_QCOM_HV_HAPTICS is not set
CONFIG_INPUT_AW8697_HAPTIC=y

# Schedutil
CONFIG_XIAOMI_CPUFREQ_EFF=y

# Time of flight
CONFIG_STMVL53L5=y

# Power Supply
CONFIG_BQ2597X=y
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_BQ_FG_1S=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_DEVICE_ACCESS=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_I2C=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_LOADER=y
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# WiFi
CONFIG_CNSS_QCA6490=y

# Wireless charging
CONFIG_MI_WIRELESS=y

#
# 5.10 size trim: olddefconfig turned on whole subsystems the 5.4 config never
# had, because new symbols take their Kconfig defaults. None of this is used on
# a phone, and the kernel Image has to fit the boot partition alongside the
# ramdisk. Camera/video V4L2 support is deliberately left alone - techpack needs it.
#
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_DVB_CORE is not set
# CONFIG_CXD2880_SPI_DRV is not set
# CONFIG_CRYPTO_DEV_ALLWINNER is not set
# CONFIG_SUN6I_MSGBOX is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_CRYPTO_FIPS140 is not set
# CONFIG_VHOST_MENU is not set
# CONFIG_TIPC_CRYPTO is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_UAPI_HEADER_TEST is not set
